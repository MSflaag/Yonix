# ── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
SITE_URL=https://your-project.vercel.app

# ── Resend (emails) ─────────────────────────────────────────────────────────
# Clé API Resend : https://resend.com/api-keys
RESEND_API_KEY=re_...

# Adresse expéditeur — OBLIGATOIRE pour envoyer vers n'importe quel email.
#
# Option A (recommandée) : domaine vérifié dans Resend
#   1. Va sur https://resend.com/domains → "Add Domain"
#   2. Ajoute les enregistrements DNS chez ton hébergeur (TXT + MX)
#   3. Une fois vérifié, utilise : Yonix <no-reply@ton-domaine.com>
#
# Option B (test uniquement) : adresse sandbox Resend
#   Ne fonctionne QUE vers l'email vérifié de ton compte Resend.
#   Impossible d'envoyer vers d'autres adresses → erreur 403/422.
#   Laisse vide pour utiliser la sandbox (tests seulement).
#
RESEND_FROM=Yonix <no-reply@ton-domaine.com>

# ── Auth ────────────────────────────────────────────────────────────────────
# Clé secrète HMAC — génère une chaîne aléatoire de 32+ caractères :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=genere-une-cle-aleatoire-de-32-chars-ici

# ── Discord ──────────────────────────────────────────────────────────────────
# Bot Discord pour les notifications de commande (DM privé + ping)
# 1. https://discord.com/developers/applications → New Application → Bot → Reset Token
# 2. Ton User ID : Paramètres Discord → Avancé → Mode développeur ON
#    → Clic droit sur ton nom → Copier l'ID
DISCORD_BOT_TOKEN=Bot_token_ici
DISCORD_OWNER_ID=ton_discord_user_id

# ── Téléchargements ─────────────────────────────────────────────────────────
# Secret pour signer les URLs de téléchargement (token à usage unique)
# Génère avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOWNLOAD_SECRET=genere-une-cle-aleatoire-ici

# Identifiants OAuth2 Discord
DISCORD_CLIENT_ID=client_id_ici
DISCORD_CLIENT_SECRET=client_secret_ici
DISCORD_REDIRECT_URI=https://your-project.vercel.app/api/auth/discord-callback

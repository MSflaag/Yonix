# Discord bot — DM notifications to owner
# 1. Create a bot at https://discord.com/developers/applications
# 2. Under Bot → copy the Token → DISCORD_BOT_TOKEN
# 3. Enable "Privileged Gateway Intents" if needed
# 4. Your Discord user ID → DISCORD_OWNER_ID
#    (Settings → Advanced → Developer Mode → right-click your name → Copy ID)
DISCORD_BOT_TOKEN=Bot_token_here
DISCORD_OWNER_ID=your_discord_user_id
